# ==========================================
# KONFIGURATION DES POKÉMON-TCG-WÄCHTERS (SATELLA)
# ==========================================

# --- TELEGRAM BOT (Empfohlen) ---
# 1. Öffne Telegram und suche nach @BotFather
# 2. Sende /newbot und folge den Schritten -> Du erhältst einen Bot Token
# 3. Trage den Token hier ein:
TELEGRAM_BOT_TOKEN=

# 4. Deine Telegram Chat-ID:
# Starte deinen Bot mit 'start.bat' und schreibe deinem Bot auf Telegram einfach /start.
# Der Bot antwortet dir direkt mit deiner genauen Chat-ID! Trage sie dann hier ein:
TELEGRAM_CHAT_ID=

# --- DISCORD WEBHOOK (Optional) ---
# In Discord: Server-Einstellungen -> Integrationen -> Webhooks -> Neuer Webhook
DISCORD_WEBHOOK_URL=

# --- NTFY.SH PUSH (Optional, super einfach ohne Account) ---
# Installiere die kostenlose 'ntfy' App (iOS/Android) und trage ein geheimes Topic ein:
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# --- SCAN-EINSTELLUNGEN ---
# Prüfintervall in Minuten (Standard: 10)
CHECK_INTERVAL_MINUTES=10

# Pause zwischen Seitenaufrufen in Sekunden (schont Shops und verhindert Blocks)
REQUEST_DELAY_MIN=1.5
REQUEST_DELAY_MAX=3.5

# Detaillierte Produktseite prüfen für genauen Status, Preis & Bild (true / false)
CHECK_PRODUCT_PAGES=true

# Unbekannte Sprache als deutsch behandeln? (in deutschen Shops üblich)
UNKNOWN_LANGUAGE_OK=true

# Beim ersten Start vorhandene Produkte anpingen? (false = erst ab 2. Lauf Änderungen melden)
NOTIFY_FIRST_RUN=false
